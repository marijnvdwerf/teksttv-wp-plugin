{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["resources/**", "tests/**", "playwright.config.ts"]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "complexity": {
                "noImportantStyles": "off"
            },
            "correctness": {
                "noUnusedVariables": "warn"
            }
        }
    },
    "overrides": [
        {
            "includes": ["resources/css/partials/blocks.css"],
            "linter": {
                "rules": {
                    "style": {
                        "noDescendingSpecificity": "off"
                    }
                }
            }
        }
    ],
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        },
        "globals": ["tinymce", "wp", "teksttvPost"]
    }
}
