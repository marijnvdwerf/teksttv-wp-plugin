{
    "name": "teksttv-wp-plugin",
    "private": true,
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "bun run build:js && bun run build:css && bun run build:static",
        "build:js": "bun build resources/ts/admin.ts --outdir assets --format=iife --minify-whitespace --minify-syntax",
        "build:css": "bun build resources/css/admin.css --outdir assets --minify",
        "build:static": "cp resources/ts/tinymce-separator.js assets/ && cp resources/css/tinymce-content.css assets/",
        "dev": "bun run build:js -- --watch & bun run build:css -- --watch",
        "check": "bun run lint:php && bun run check:frontend",
        "check:frontend": "bun run lint:js && bun run typecheck && bun run test:js",
        "lint:php": "vendor/bin/phpcs",
        "lint:js": "biome check .",
        "lint:fix": "vendor/bin/phpcbf; p=$?; biome check --write . && [ $p -le 1 ]",
        "typecheck": "tsc && tsc -p tsconfig.tests.json",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/phpunit",
        "test:js": "bun test tests/js --isolate",
        "build:package": "bun run build && bash bin/package-plugin.sh",
        "env:start": "bun run build:package && bun tests/e2e/start-playground.ts",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "alpinejs": "^3.17.4",
        "sortablejs": "^1.15.7",
        "tom-select": "^2.6.2"
    },
    "overrides": {
        "adm-zip": "0.6.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@playwright/test": "^1.64.1",
        "@wp-playground/cli": "3.1.58",
        "@types/bun": "1.4.3",
        "@types/sortablejs": "^1.15.9",
        "typescript": "7.0.2"
    }
}
